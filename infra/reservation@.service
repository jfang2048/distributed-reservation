[Unit]
Description=Reservation lab node %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=reservation
WorkingDirectory=/opt/reservation
ExecStart=/usr/bin/java -jar build/reservation.jar server --node %i
Restart=no
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
